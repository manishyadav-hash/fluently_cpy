generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum SubscriptionStatus {
  none
  trial
  active
  expired
  cancelled
}

enum SubscriptionInterval {
  month
  year
}

enum SubscriptionSubStatus {
  trial
  active
  expired
  cancelled
  pending
}

enum LessonType {
  speaking_drill
  audio_response
  fluency_drill
  conversation
}

enum LessonStatus {
  locked
  available
  in_progress
  completed
}

enum LearningGoal {
  crack_interviews
  speak_confidently
  office_communication
  daily_conversations
}

enum SpeakingChallenge {
  freeze_while_speaking
  translate_in_mind
  words_dont_come
  fear_mistakes
}

enum ThirtyDayGoal {
  clear_interviews
  speak_without_hesitation
  sound_confident
  daily_conversations
}

enum MessageRole {
  user
  tutor
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

model User {
  id                 String             @id @default(cuid())
  phone              String             @unique
  name               String?
  email              String?            @unique
  avatarUrl          String?
  isOnboarded        Boolean            @default(false)
  subscriptionStatus SubscriptionStatus @default(none)
  trialUsedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  otp              Otp[]
  refreshTokens    RefreshToken[]
  questionnaire    QuestionnaireAnswers?
  stats            UserStats?
  settings         UserSettings?
  subscription     Subscription?
  conversations    Conversation[]
  lessonProgress   UserLessonProgress[]
}

model Otp {
  id         String    @id @default(cuid())
  identifier String
  code       String
  attemptCount Int     @default(0)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([identifier])
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─── Onboarding ───────────────────────────────────────────────────────────────

model QuestionnaireAnswers {
  id                   String            @id @default(cuid())
  userId               String            @unique
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningGoal         LearningGoal
  speakingChallenge    SpeakingChallenge
  thirtyDayGoal        ThirtyDayGoal
  dailyPracticeMinutes Int
  createdAt            DateTime          @default(now())
}

// ─── Learning Content ─────────────────────────────────────────────────────────

model Module {
  id         String   @id @default(cuid())
  title      String
  weekNumber Int      @unique
  createdAt  DateTime @default(now())

  lessons Lesson[]
}

model Lesson {
  id                 String     @id @default(cuid())
  moduleId           String
  module             Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title              String
  type               LessonType
  durationLabel      String
  order              Int
  promptText         String?
  instructions       String?
  backgroundImageUrl String?
  createdAt          DateTime   @default(now())

  userProgress UserLessonProgress[]

  @@unique([moduleId, order])
  @@index([moduleId])
}

model UserLessonProgress {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId       String
  lesson         Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status         LessonStatus @default(locked)
  audioSubmitted Boolean      @default(false)
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  audioSubmissions LessonAudioSubmission[]

  @@unique([userId, lessonId])
  @@index([userId])
}

model LessonAudioSubmission {
  id                   String             @id @default(cuid())
  userLessonProgressId String
  userLessonProgress   UserLessonProgress @relation(fields: [userLessonProgressId], references: [id], onDelete: Cascade)
  durationSeconds      Float
  pronunciationScore   Float?
  fluencyScore         Float?
  grammarScore         Float?
  overallScore         Float?
  suggestions          String[]
  xpEarned             Int                @default(0)
  createdAt            DateTime           @default(now())

  @@index([userLessonProgressId])
}

// ─── User Stats ───────────────────────────────────────────────────────────────

model UserStats {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  xp                   Int       @default(0)
  rating               Float     @default(0)
  currentStreakDays    Int       @default(0)
  lastActivityDate     DateTime?
  lessonsCompleted     Int       @default(0)
  totalPracticeMinutes Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// ─── Subscriptions ────────────────────────────────────────────────────────────

model SubscriptionPlan {
  id                String               @id
  name              String
  interval          SubscriptionInterval
  priceAmount       Int
  priceCurrency     String               @default("INR")
  monthlyEquivalent Int?
  badge             String?
  description       String?
  isActive          Boolean              @default(true)
  createdAt         DateTime             @default(now())

  subscriptions Subscription[]
}

model Subscription {
  id                 String                @id @default(cuid())
  userId             String                @unique
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId             String?
  plan               SubscriptionPlan?     @relation(fields: [planId], references: [id])
  status             SubscriptionSubStatus
  trialEndDate       DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean               @default(false)
  paymentUrl         String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([userId])
}

// ─── AI Tutor Chat ────────────────────────────────────────────────────────────

model Conversation {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastMessageAt DateTime?
  messageCount  Int       @default(0)
  createdAt     DateTime  @default(now())

  messages ChatMessage[]

  @@index([userId])
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

// ─── Settings ─────────────────────────────────────────────────────────────────

model UserSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language             String   @default("en")
  notificationsEnabled Boolean  @default(true)
  dailyReminderTime    String   @default("09:00")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}
