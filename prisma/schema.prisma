// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum QuestionType {
  mcq
  single_choice
  speak_to_text
  text_to_speech
  fill_in_blank
}

enum LessonType {
  speaking
  audio
  quiz
  match
  reading
  writing
  mixed
}

enum CourseLevel {
  beginner
  intermediate
  advanced
}

enum CourseAudience {
  student
  college_student
  job_seeker
  working_professional
  business_professional
  general_learner
}

enum CourseStatus {
  draft
  in_review
  published
  archived
}

enum LessonLevel {
  beginner
  intermediate
  advanced
}

model Course {
  id             String        @id @default(uuid()) @db.Uuid
  title          String
  description    String?
  thumbnailUrl   String?       @map("thumbnail_url")
  level          CourseLevel   @default(beginner)
  audience       CourseAudience @default(general_learner)
  durationWeeks   Int           @map("duration_weeks")
  status         CourseStatus  @default(draft)
  createdAt      DateTime      @default(now()) @map("created_at")

  weeks Week[]

  @@map("courses")
}

model Week {
  id           String   @id @default(uuid()) @db.Uuid
  courseId     String   @map("course_id") @db.Uuid
  weekNo       Int      @map("week_no")
  title        String?
  thumbnailUrl String?  @map("thumbnail_url")
  createdAt    DateTime @default(now()) @map("created_at")

  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  weekLessons WeekLesson[]

  @@unique([courseId, weekNo])
  @@map("weeks")
}

model Lesson {
  id          String      @id @default(uuid()) @db.Uuid
  title       String
  lessonLevel LessonLevel @default(beginner) @map("lesson_level")
  lessonType  LessonType  @default(mixed) @map("lesson_type")
  thumbnail   String?     @map("thumbnail")
  duration    String?     @map("duration")
  contentBlocks Json?     @map("content_blocks")
  createdAt   DateTime    @default(now()) @map("created_at")
  weekLessons WeekLesson[]

  @@map("lessons")
}

model WeekLesson {
  id         String   @id @default(uuid()) @db.Uuid
  weekId     String   @map("week_id") @db.Uuid
  lessonId   String   @map("lesson_id") @db.Uuid
  lessonOrder Int     @map("lesson_order")
  contentBlocks Json? @map("content_blocks")
  createdAt  DateTime @default(now()) @map("created_at")

  week   Week   @relation(fields: [weekId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questionLinks WeekLessonQuestion[]

  @@unique([weekId, lessonId])
  @@unique([weekId, lessonOrder])
  @@map("week_lessons")
}

model Question {
  id            String       @id @default(uuid()) @db.Uuid
  questionType  QuestionType @map("question_type")
  question      String
  audioUrl      String?      @map("audio_url")
  imageUrl      String?      @map("image_url")
  correctAnswer String?      @map("correct_answer")
  questionOrder Int          @map("question_order")
  createdAt     DateTime     @default(now()) @map("created_at")

  placements WeekLessonQuestion[]
  options    QuestionOption[]
  attempts   QuestionAttempt[]

  @@map("questions")
}

model WeekLessonQuestion {
  id            String   @id @default(uuid()) @db.Uuid
  weekLessonId  String   @map("week_lesson_id") @db.Uuid
  questionId    String   @map("question_id") @db.Uuid
  questionOrder Int      @map("question_order")
  createdAt     DateTime @default(now()) @map("created_at")

  weekLesson WeekLesson @relation(fields: [weekLessonId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([weekLessonId, questionId])
  @@unique([weekLessonId, questionOrder])
  @@map("week_lesson_questions")
}

model QuestionOption {
  id         String  @id @default(uuid()) @db.Uuid
  questionId String  @map("question_id") @db.Uuid
  optionText String  @map("option_text")
  isCorrect  Boolean @default(false) @map("is_correct")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, optionText])
  @@map("question_options")
}


model QuestionAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  answer     String?
  isCorrect  Boolean  @default(false) @map("is_correct")
  createdAt  DateTime @default(now()) @map("created_at")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_attempts")
}
